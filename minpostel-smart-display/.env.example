# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=msd_db

# Security & Secrets
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=8h
COOKIE_SECRET=change_this_cookie_secret

# Display Configuration
DEFAULT_DISPLAY_ID=MINPOSTEL-MAIN-ENTRANCE-01
ROTATION_DURATION_SECONDS=10
LANGUAGE_CYCLE_SECONDS=10
HEARTBEAT_INTERVAL_SECONDS=15
HEARTBEAT_TIMEOUT_SECONDS=45

# Google Weather API Configuration (Google Maps Platform Weather API)
# Get a key at: https://console.cloud.google.com/ (Enable Weather API)
GOOGLE_WEATHER_API_KEY=
